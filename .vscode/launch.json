{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Demo walkthrough",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/demo.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Demo walkthrough (real store data)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/demo.py",
      "args": ["--real"],
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Run tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-v"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}
