# --- Data sources (each turns on when its key is set) ---
SERPAPI_KEY=
BESTBUY_API_KEY=

# Shopify agentic commerce (search + buying)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_CATALOG_URL=
SHOPIFY_AGENT_PROFILE=

# --- Behaviour ---
# 1 = always include demo data, 0 = never. Unset = demo only when no real source is configured.
PRICEHAWK_DEMO=
PRICEHAWK_COUNTRY=us

# --- Buying guardrails ---
PRICEHAWK_MAX_ORDER=500
# Comma-separated store names or domains. Empty = any store.
PRICEHAWK_ALLOWED_STORES=
PRICEHAWK_BUYER_EMAIL=

# --- Storage / transport ---
# PRICEHAWK_DB=~/.pricehawk/pricehawk.db
# PRICEHAWK_TRANSPORT=stdio   # or streamable-http
