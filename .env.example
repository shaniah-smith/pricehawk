# Copy this file to .env and paste your key. PriceHawk reads .env when the server starts.

# One SerpAPI key powers all three live stores: Google Shopping, Walmart and eBay.
# Free key: https://serpapi.com/manage-api-key
SERPAPI_KEY=

# Turn individual stores off (0) to save searches. Each store uses one search per lookup.
PRICEHAWK_WALMART=1
PRICEHAWK_EBAY=1

# Demo data (fictional stores). Unset = only when SERPAPI_KEY is missing. 1 = always mix it in, 0 = never.
PRICEHAWK_DEMO=
PRICEHAWK_COUNTRY=us

# --- Storage / transport ---
# PRICEHAWK_DB=~/.pricehawk/pricehawk.db
# PRICEHAWK_TRANSPORT=stdio   # or streamable-http
